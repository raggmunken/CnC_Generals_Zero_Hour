# ---------------------------------------------------------------------------
# Copy to .env and edit. Only GAME_PATH is mandatory.
# ---------------------------------------------------------------------------

# Absolute path to your Command & Conquer: Generals Zero Hour install.
# This is the directory that contains game.dat and the *.BIG archives.
# It is bind-mounted read-only; nothing is copied into the image.
#   Steam:  ~/.steam/steam/steamapps/common/Command and Conquer Generals Zero Hour
#   EA App: C:\Program Files (x86)\EA Games\Command and Conquer Generals Zero Hour
GAME_PATH=/srv/games/Command and Conquer Generals Zero Hour

# Executable inside GAME_PATH. Retail Zero Hour is game.dat.
GAME_EXE=game.dat

# Extra game arguments. -win, -xres and -yres are always supplied by the
# launcher and are ignored here.
#   -quickstart   skip the intro logos
#   -noshellmap   skip the animated main-menu map (saves a lot of CPU when
#                 software rendering)
#   -winCursors   force Windows cursors if the pointer is invisible in the stream
GAME_ARGS=-quickstart -noshellmap

# --- capture geometry ------------------------------------------------------
# Must be a resolution the game offers. 4:3 options are the best tested;
# 1600x900 and 1920x1080 work but the UI was designed for 4:3.
SCREEN_WIDTH=1600
SCREEN_HEIGHT=900
# The engine self-limits to ~30fps, so capturing faster only burns CPU.
GAME_FPS=30

# --- rendering -------------------------------------------------------------
# dxvk    : D3D8 -> Vulkan via DXVK's d3d8 (needs DXVK >= 2.4)
# wined3d : D3D8 -> OpenGL via Wine's own implementation
# With GPU=none, wined3d is the safer bet: llvmpipe's OpenGL is far more
# mature than lavapipe's Vulkan.
RENDERER=dxvk

# none : software rendering (llvmpipe / lavapipe)
# dri  : use the host GPU; also uncomment the devices block in docker-compose.yml
GPU=none

# win64 is the modern, best-tested prefix layout; the 32-bit game runs under
# WoW64 and DXVK's 32-bit DLLs go to syswow64. Use win32 only if you hit
# WoW64-specific problems AND your Wine build still supports 32-bit prefixes.
WINEARCH=win64

# --- Wine build ------------------------------------------------------------
# winehq + staging is the most forgiving combination for a 2003 D3D8 title.
# Set WINE_SOURCE=distro to use Ubuntu's own wine packages instead.
WINE_BRANCH=staging
WINE_SOURCE=winehq

# DXVK release to install. 3.x requires a Vulkan 1.4-era driver, which stock
# Ubuntu 24.04 lavapipe does NOT provide -- keep 2.7.1 unless you have a real
# GPU (or set MESA_PPA=1).
DXVK_VERSION=2.7.1
MESA_PPA=0

# --- encoding --------------------------------------------------------------
# x264 (software, always available) | vaapi | nvenc
ENCODER=x264
# x264 speed-preset. ultrafast if the encoder is your bottleneck.
ENCODER_PRESET=veryfast
VIDEO_BITRATE_KBPS=12000
AUDIO_ENABLED=1

# --- transport -------------------------------------------------------------
STREAM_PORT=8080
STUN_SERVER=stun://stun.l.google.com:19302
# Only needed if the browser and the host cannot reach each other directly.
TURN_SERVER=
# How many remote pixels from the edge count as "on the edge". The game's own
# scroll band is 3px, which is unhittable through a scaled video; this widens
# the target. Raise it if edge scrolling feels unreliable, lower it if the
# camera runs away while you are aiming near the screen border.
EDGE_SNAP_PX=4

LOG_LEVEL=INFO
